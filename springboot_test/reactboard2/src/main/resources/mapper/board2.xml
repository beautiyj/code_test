<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.dao.BoardDao">

	<insert id="insert" parameterType="board">
	   insert into reactboard2(no,writer,title,content,register) 
	   values(reactboard2_seq.nextval,#{writer},#{title},#{content},sysdate)
	</insert>	
	
	<select id="getBoardList" resultType="board">	
		select * from reactboard2 order by no desc
	</select>
	
</mapper>




